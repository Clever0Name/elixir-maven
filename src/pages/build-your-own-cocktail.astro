---
import Layout from '../layouts/Layout.astro';
import cocktailsData from '../../elixir_maven_cocktails.json';
import cooccurrenceData from '../../:design-reference:/files 2/cooccurrence_table.json';

// Extract ingredient categories from the JSON
const extractIngredients = () => {
  const categories = {
    spirits: new Set<string>(),
    citrus: new Set<string>(),
    juice: new Set<string>(),
    syrup: new Set<string>(),
    puree: new Set<string>(),
    botanicals: new Set<string>(),
    liqueur: new Set<string>(),
    mixer: new Set<string>(),
    bitters: new Set<string>(),
    foamer: new Set<string>()
  };

  const spiritNormalization: Record<string, string[]> = {
    'White Rum': ['White Rum'],
    'Dark Rum': ['Dark Rum'],
    'Aged Rum': ['Dark Rum'],
    'Dark Aged Rum': ['Dark Rum'],
    'Spiced Rum': ['Spiced Rum'],
    'Overproof Rum': ['Overproof Rum'],
    'Coconut Rum': ['Coconut Rum'],
    'Blanco Tequila': ['Tequila'],
    'Tequila': ['Tequila'],
    'Gin': ['Gin'],
    'Vodka': ['Vodka'],
    'Citrus Vodka': ['Vodka'],
    'Gin or Vodka': ['Gin', 'Vodka'],
    'Vodka/Gin': ['Vodka', 'Gin'],
    'Whiskey': ['Whiskey'],
    'Rye Whiskey': ['Whiskey'],
    'Scotch Whisky': ['Whiskey'],
    'Irish Whiskey': ['Whiskey'],
    'Blended Scotch Whisky': ['Whiskey'],
    'Peated Scotch': ['Whiskey'],
    'Bourbon': ['Bourbon']
  };

  const citrusNormalization: Record<string, string> = {
    'Lemon Juice': 'Lemon',
    'Lime Juice': 'Lime',
    'Lime Wedges': 'Lime'
  };

  const juiceNormalization: Record<string, string> = {
    'Apple Juice': 'Apple',
    'Blood Orange Juice': 'Blood Orange',
    'Cranberry Juice': 'Cranberry',
    'Lemon Juice': 'Lemon',
    'Lime Juice': 'Lime',
    'Orange Juice': 'Orange',
    'Pineapple Juice': 'Pineapple',
    'Pink Grapefruit Juice': 'Grapefruit',
    'Pomegranate Juice': 'Pomegranate'
  };

  const syrupNormalization: Record<string, string> = {
    'Agave Syrup': 'Agave',
    'Caramel Syrup': 'Caramel',
    'Cinnamon Syrup': 'Cinnamon',
    'Coconut Syrup': 'Coconut',
    'Falernum': 'Falernum',
    'Grenadine': 'Grenadine',
    'Honey and Ginger Syrup': 'Honey',
    'Honey Syrup': 'Honey',
    'Maple Syrup': 'Maple',
    'Orgeat': 'Orgeat',
    'Sugar Syrup': 'Sugar syrup',
    'Vanilla Syrup': 'Vanilla'
  };

  const pureeNormalization: Record<string, string> = {
    'Mango Puree': 'Mango',
    'Mango Purée': 'Mango',
    'Peach Puree': 'Peach',
    'Peach Purée': 'Peach',
    'Passion Fruit Puree': 'Passion Fruit',
    'Passion Fruit Purée': 'Passion Fruit',
    'Strawberry Puree': 'Strawberry',
    'Strawberry Purée': 'Strawberry'
  };

  const botanicalNormalization: Record<string, string> = {
    'Fresh Ginger': 'Fresh Ginger',
    'Mint Leaves': 'Mint Leaves',
    'Fresh Basil Leaves': 'Fresh Basil Leaves'
  };

  const rejectedSyrups = new Set(['Butterfly Pea Flower Syrup', 'Strawberry Syrup']);
  const allowedPurees = new Set(['Passion Fruit', 'Strawberry', 'Mango', 'Peach']);

  const mixerNormalization: Record<string, string> = {
    'Club Soda': 'Soda',
    'Cola': 'Cola',
    'Ginger Beer': 'Ginger Beer',
    'Grapefruit Soda': 'Grapefruit Soda',
    'Lemonade': 'Lemonade',
    'Prosecco': 'Sparkling Wine',
    'Sparkling Wine': 'Sparkling Wine',
    'Soda': 'Soda',
    'Soda Water': 'Soda',
    'Tomato Juice': 'Tomato Juice',
    'Tonic': 'Tonic Water',
    'Tonic Water': 'Tonic Water'
  };

  cocktailsData.cocktails.forEach(cocktail => {
    cocktail.ingredients.forEach(ing => {
      const role = ing.role.toLowerCase();
      if (role.includes('garnish')) {
        return;
      }

      if (role.includes('spirit')) {
        const mappedSpirits = spiritNormalization[ing.name] || [ing.name];
        mappedSpirits.forEach(spirit => categories.spirits.add(spirit));
      } else if (role.includes('citrus')) {
        categories.citrus.add(citrusNormalization[ing.name] || ing.name);
      } else if (role.includes('juice')) {
        categories.juice.add(juiceNormalization[ing.name] || ing.name);
      } else if (role.includes('syrup') || role.includes('sweetener')) {
        const syrupName = syrupNormalization[ing.name] || ing.name;
        if (!rejectedSyrups.has(syrupName)) categories.syrup.add(syrupName);
      } else if (role.includes('puree')) {
        const pureeName = pureeNormalization[ing.name] || ing.name;
        if (allowedPurees.has(pureeName)) categories.puree.add(pureeName);
      } else if (role.includes('herb')) {
        const botanicalName = botanicalNormalization[ing.name] || ing.name;
        if (botanicalNormalization[ing.name]) categories.botanicals.add(botanicalName);
      } else if (role === 'ingredient') {
        if (citrusNormalization[ing.name]) categories.citrus.add(citrusNormalization[ing.name]);
        if (botanicalNormalization[ing.name]) categories.botanicals.add(botanicalNormalization[ing.name]);
      } else if (role.includes('liqueur') || role.includes('aperitif') || role.includes('amaro') || role.includes('bitter liqueur')) {
        categories.liqueur.add(ing.name);
      } else if (role.includes('mixer') || role.includes('sparkling wine')) {
        categories.mixer.add(mixerNormalization[ing.name] || ing.name);
      } else if (role.includes('bitters')) {
        categories.bitters.add(ing.name);
      } else if (role.includes('foamer')) {
        categories.foamer.add(ing.name);
      }
    });
  });

  return {
    spirits: Array.from(categories.spirits).sort(),
    citrus: ['None', ...Array.from(categories.citrus).sort()],
    juice: ['None', ...Array.from(categories.juice).filter(item => !['Lemon', 'Lime'].includes(item)).sort()],
    syrup: ['None', ...Array.from(categories.syrup).sort()],
    puree: ['None', ...Array.from(categories.puree).sort()],
    botanicals: ['None', ...Array.from(categories.botanicals).sort()],
    liqueur: Array.from(categories.liqueur).sort(),
    mixer: ['None', ...Array.from(categories.mixer).sort()],
    bitters: Array.from(categories.bitters).sort(),
    foamer: Array.from(categories.foamer).sort()
  };
};

const ingredients = extractIngredients();
if (!ingredients.juice.includes('Blood Orange')) ingredients.juice.push('Blood Orange');
if (!ingredients.juice.includes('Pomegranate')) ingredients.juice.push('Pomegranate');
if (!ingredients.syrup.includes('Elderflower')) ingredients.syrup.push('Elderflower');
if (!ingredients.syrup.includes('Agave')) ingredients.syrup.push('Agave');
if (!ingredients.syrup.includes('Cinnamon')) ingredients.syrup.push('Cinnamon');
if (!ingredients.syrup.includes('Caramel')) ingredients.syrup.push('Caramel');
ingredients.syrup = ingredients.syrup.filter(item => !['Butterfly Pea Flower Syrup', 'Strawberry Syrup'].includes(item));
if (!ingredients.foamer.includes('Egg White')) ingredients.foamer.unshift('Egg White');
if (!ingredients.juice.includes('Apple')) ingredients.juice.push('Apple');
if (!ingredients.mixer.includes('Tonic Water')) ingredients.mixer.push('Tonic Water');
if (!ingredients.mixer.includes('Sparkling Wine')) ingredients.mixer.push('Sparkling Wine');
if (!ingredients.mixer.includes('Grapefruit Soda')) ingredients.mixer.push('Grapefruit Soda');
if (!ingredients.bitters.includes('Orange Bitters')) ingredients.bitters.push('Orange Bitters');
if (!ingredients.bitters.includes('Walnut Bitters')) ingredients.bitters.push('Walnut Bitters');
if (!ingredients.puree.includes('Passion Fruit')) ingredients.puree.push('Passion Fruit');
if (!ingredients.puree.includes('Strawberry')) ingredients.puree.push('Strawberry');
if (!ingredients.puree.includes('Mango')) ingredients.puree.push('Mango');
if (!ingredients.puree.includes('Peach')) ingredients.puree.push('Peach');
ingredients.puree = ingredients.puree.filter(item => ['None', 'Passion Fruit', 'Strawberry', 'Mango', 'Peach'].includes(item));
if (!ingredients.botanicals.includes('Fresh Ginger')) ingredients.botanicals.push('Fresh Ginger');
if (!ingredients.botanicals.includes('Mint Leaves')) ingredients.botanicals.push('Mint Leaves');
if (!ingredients.botanicals.includes('Fresh Basil Leaves')) ingredients.botanicals.push('Fresh Basil Leaves');
if (!ingredients.liqueur.includes('Elderflower Liqueur')) ingredients.liqueur.push('Elderflower Liqueur');
if (!ingredients.liqueur.includes('Orange Liqueur')) ingredients.liqueur.push('Orange Liqueur');
if (!ingredients.liqueur.includes('Midori')) ingredients.liqueur.push('Midori');
if (!ingredients.liqueur.includes('Crème de Cassis')) ingredients.liqueur.push('Crème de Cassis');
if (!ingredients.liqueur.includes('Nectarine')) ingredients.liqueur.push('Nectarine');

ingredients.juice = ['None', ...ingredients.juice.filter(item => item !== 'None').sort()];
ingredients.syrup = ['None', ...ingredients.syrup.filter(item => item !== 'None').sort()];
ingredients.mixer = ['None', ...ingredients.mixer.filter(item => item !== 'None').sort()];
ingredients.puree = ['None', ...ingredients.puree.filter(item => item !== 'None').sort()];
ingredients.botanicals = ['None', ...ingredients.botanicals.filter(item => item !== 'None').sort()];
ingredients.bitters = ingredients.bitters.sort();
ingredients.liqueur = ingredients.liqueur.sort();
const evidencePairs = cooccurrenceData.pairs;
const suggestionCocktails = cocktailsData.cocktails.map((cocktail) => {
  const published = (cocktail as { published?: boolean }).published ?? true;
  const approvedForSuggestion = (cocktail as { approved_for_suggestion?: boolean }).approved_for_suggestion ?? false;
  return {
    ...cocktail,
    published,
    approved_for_suggestion: published || approvedForSuggestion,
  };
});
---

<Layout
  title="Build Your Own Cocktail — Elixir Maven"
  description="Create your own custom cocktail with our interactive builder. Mix spirits, citrus, juices, and syrups to craft the perfect drink."
>
  <style is:global define:vars={{ '--holo-pink': '#F4C6DD', '--holo-purple': '#C9AEEF', '--holo-blue': '#9FC6F0', '--holo-cyan': '#9CE7EA', '--holo-gold': '#E9C98A' }}>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,600&family=Jost:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

    :root {
      --bg: #0F0B0C;
      --panel: #1A1113;
      --cream: #F2E6D8;
      --brass: #C99A6B;
      --muted: #8a7a72;
      --border: #2a1e20;
      --chip-text: #E3D6C9;
    }

    /* ─── Holographic gradient ─── */
    @keyframes shimmer {
      0% { background-position: 0% 50%; }
      100% { background-position: 300% 50%; }
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .byoc-page {
      background: var(--bg);
      color: var(--cream);
      padding: 40px 32px 100px;
    }

    .byoc-wrap {
      max-width: 1280px;
      margin: 0 auto;
    }

    /* ─── Header ─── */
    .byoc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 30px;
      gap: 20px;
    }

    .byoc-header-block {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .byoc-wordmark {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-weight: 600;
      font-size: 72px;
      margin: 0;
      letter-spacing: 0.5px;
      line-height: 1.1;
    }

    .byoc-wordmark .elixir {
      color: var(--brass);
    }

    .byoc-wordmark .maven {
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A, #F4C6DD);
      background-size: 300% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: shimmer 16s linear infinite;
    }

    .byoc-membership {
      font-size: 13px;
      font-weight: 400;
      color: var(--cream);
      margin: 2px 0 0 0;
      letter-spacing: 0.3px;
    }

    .byoc-title {
      font-size: 15px;
      font-weight: 400;
      color: var(--muted);
      margin: 18px 0 0 0;
      letter-spacing: 0.5px;
    }

    /* ─── Toggle ─── */
    .byoc-toggle {
      display: inline-flex;
      background: var(--panel);
      border-radius: 999px;
      padding: 3px;
      gap: 2px;
    }

    .byoc-toggle button {
      padding: 6px 16px;
      font-size: 12px;
      font-family: 'IBM Plex Mono', monospace;
      border-radius: 999px;
      color: var(--muted);
      background: none;
      border: none;
      cursor: pointer;
      transition: all 0.15s;
    }

    .byoc-toggle .active {
      padding: 3px;
      border-radius: 999px;
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A, #F4C6DD);
      background-size: 400% 100%;
      background-position: 50% 50%;
    }

    .byoc-toggle .active button {
      background: var(--bg);
      color: var(--cream);
      display: block;
    }

    .byoc-toggle > div {
      border-radius: 999px;
    }

    .byoc-toggle > div:not(.active) {
      padding: 3px;
    }

    .byoc-toggle > div:not(.active) button {
      display: block;
      padding: 6px 16px;
    }

    /* ─── Category Groups ─── */
    .byoc-category-group {
      margin-bottom: 18px;
    }

    .byoc-category-header {
      font-size: 13px;
      font-weight: 500;
      padding: 8px 12px;
      border-radius: 6px;
      cursor: pointer;
      background: var(--panel2);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--chip-text);
      transition: all 0.15s;
      user-select: none;
    }

    .byoc-category-header:hover {
      background: rgba(255, 255, 255, 0.05);
    }

    /* Each ingredient category keeps its own related prism range. */
    .byoc-category-group--aperitif .byoc-category-header {
      border-color: rgba(234, 145, 86, 0.72);
      background: linear-gradient(135deg, rgba(244, 198, 221, 0.10), rgba(233, 201, 138, 0.12), rgba(234, 145, 86, 0.14), rgba(244, 230, 166, 0.10));
      box-shadow: inset 0 0 0 1px rgba(234, 145, 86, 0.32);
      color: var(--chip-text);
    }

    .byoc-category-group--natural-sugar .byoc-category-header {
      border-color: rgba(244, 198, 221, 0.42);
      background: linear-gradient(135deg, rgba(244, 198, 221, 0.10), rgba(239, 181, 210, 0.08), rgba(222, 174, 218, 0.08), rgba(201, 174, 239, 0.08));
    }

    .byoc-category-group--fruit-citrus .byoc-category-header {
      border-color: rgba(159, 198, 240, 0.42);
      background: linear-gradient(135deg, rgba(159, 198, 240, 0.10), rgba(140, 207, 239, 0.08), rgba(156, 231, 234, 0.08), rgba(174, 233, 214, 0.08));
    }

    .byoc-category-group--spice-nut-floral .byoc-category-header {
      border-color: rgba(233, 201, 138, 0.42);
      background: linear-gradient(135deg, rgba(233, 201, 138, 0.10), rgba(221, 216, 149, 0.08), rgba(190, 222, 166, 0.08), rgba(156, 231, 234, 0.08));
    }

    .byoc-category-header-toggle {
      display: inline-flex;
      align-items: center;
      width: 16px;
      height: 16px;
      margin-right: 8px;
      font-size: 10px;
      color: var(--brass);
    }

    .byoc-category-header.open .byoc-category-header-toggle::before {
      content: '▼';
    }

    .byoc-category-header:not(.open) .byoc-category-header-toggle::before {
      content: '▶';
    }

    .byoc-category-header-label {
      flex: 1;
    }

    .byoc-category-indicator {
      font-size: 11px;
      color: var(--brass);
      white-space: nowrap;
      margin-left: 8px;
    }

    .byoc-category-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px 12px 0;
      max-height: 500px;
      overflow: hidden;
      transition: all 0.2s;
    }

    .byoc-category-chips.collapsed {
      max-height: 0;
      padding: 0 12px;
    }

    /* ─── Layout ─── */
    .byoc-grid {
      display: flex;
      gap: 34px;
      align-items: flex-start;
      flex-wrap: wrap;
      margin-top: 30px;
    }

    .byoc-filters {
      flex: 1 1 380px;
      min-width: 320px;
    }

    .byoc-mode-toggle {
      margin: 0 0 24px;
    }

    .byoc-freeform {
      display: none;
      margin-bottom: 30px;
    }

    .byoc-freeform.open {
      display: block;
    }

    .freeform-active .byoc-result-col {
      display: none;
    }

    .byoc-freeform-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .byoc-freeform-category {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .byoc-freeform-field {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 92px;
      gap: 8px;
    }

    .byoc-freeform-field--single {
      grid-template-columns: 1fr;
    }

    .byoc-freeform-field--choice {
      grid-template-columns: minmax(0, 1fr) 120px;
    }

    .byoc-freeform-field--second {
      margin-left: 18px;
    }

    .byoc-amount-field {
      display: flex;
      align-items: center;
      gap: 4px;
      min-width: 0;
    }

    .byoc-amount-field input {
      flex: 1 1 0;
      width: 0;
    }

    .byoc-amount-unit {
      color: var(--muted);
      font: 10px 'IBM Plex Mono', monospace;
    }

    .byoc-freeform-field input,
    .byoc-freeform-field select {
      min-width: 0;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--panel);
      color: var(--cream);
      padding: 9px 10px;
      font: 12px 'IBM Plex Mono', monospace;
      /* Forces native dropdowns (datalist/select popups) to render light bg + dark text consistently across browsers. */
      color-scheme: light;
    }

    .byoc-freeform-input-wrap {
      position: relative;
      min-width: 0;
    }

    .byoc-freeform-input-wrap .byoc-freeform-input {
      width: 100%;
    }

    .byoc-suggestion-list {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 4px);
      z-index: 20;
      display: flex;
      flex-direction: column;
      gap: 2px;
      max-height: 200px;
      overflow-y: auto;
      background: rgba(17, 12, 14, 0.98);
      border: 1px solid var(--border);
      border-radius: 6px;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.3);
      padding: 4px;
    }

    .byoc-suggestion-list[hidden] {
      display: none;
    }

    .byoc-suggestion-item {
      width: 100%;
      background: transparent;
      border: none;
      color: var(--cream);
      text-align: left;
      padding: 7px 8px;
      border-radius: 4px;
      font: 12px 'IBM Plex Mono', monospace;
      cursor: pointer;
    }

    .byoc-suggestion-item:hover,
    .byoc-suggestion-item:focus {
      background: rgba(201, 154, 107, 0.12);
      outline: none;
    }

    .byoc-freeform-result {
      margin-top: 18px;
      border-top: 1px solid var(--border);
      padding-top: 16px;
    }

    .byoc-freeform-result h3 {
      margin: 0 0 8px;
      font: 600 italic 25px 'Cormorant Garamond', serif;
    }

    .byoc-freeform-result p {
      margin: 5px 0;
      font: 11px 'IBM Plex Mono', monospace;
      color: var(--muted);
    }

    .byoc-freeform-meta {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin-top: 12px;
    }

    .byoc-freeform-meta select {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--panel);
      color: var(--cream);
      padding: 9px 10px;
      font: 12px 'IBM Plex Mono', monospace;
      color-scheme: light;
    }

    .byoc-freeform-spec {
      margin-top: 14px;
      color: var(--cream) !important;
      white-space: pre-line;
      line-height: 1.7;
    }

    @media (max-width: 600px) {
      .byoc-freeform-grid { grid-template-columns: 1fr; }
    }

    .byoc-result-col {
      flex: 1 1 300px;
      min-width: 280px;
      position: sticky;
      top: 30px;
    }

    /* ─── Filter Group ─── */
    .byoc-group {
      margin-bottom: 30px;
      margin-top: 0;
    }

    .byoc-filters .byoc-group:first-child {
      margin-top: 0;
    }

    .byoc-label {
      font-size: 15px;
      font-weight: 500;
      position: relative;
      display: inline-block;
      padding-bottom: 2px;
      margin-bottom: 14px;
    }

    .byoc-label::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 1.5px;
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A, #F4C6DD);
      box-shadow: 0 0 3px 0.2px rgba(201, 174, 239, 0.25);
    }

    .byoc-help {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      color: var(--brass);
      margin: 8px 0 0;
      min-height: 14px;
    }

    .byoc-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    /* Match the standard .byoc-group gap so Aperitif & Liqueur reads as its own section, not crowding the chip row above it. */
    #spiritCategories {
      margin-top: 30px;
    }

    .byoc-chip {
      font-size: 13px;
      padding: 8px 16px;
      border-radius: 999px;
      cursor: pointer;
      background: var(--panel);
      color: var(--chip-text);
      border: 1px solid var(--border);
      transition: opacity 0.15s;
    }

    .byoc-chip.selected {
      color: #1A1113;
      font-weight: 500;
      border: none;
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A, #F4C6DD);
      background-size: 400% 100%;
      background-position: 20% 50%;
    }

    /* Category-specific selected chip colors */
    #spiritChips .byoc-chip.selected {
      background-position: 0% 50%;
    }

    #citrusChips .byoc-chip.selected {
      background-position: 25% 50%;
    }

    #juiceChips .byoc-chip.selected {
      background: linear-gradient(90deg, #DDEBB7, #CFE3AE, #B7DDB4, #9CE7EA);
    }

