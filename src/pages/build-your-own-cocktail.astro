</Layout>

<script define:vars={{ ingredients, evidencePairs, suggestionCocktails }}>
  const SPIRITS = ingredients.spirits;
  const CITRUS = ingredients.citrus;
  const JUICE = ingredients.juice;
  const SYRUP = ingredients.syrup;
  const PUREE = ingredients.puree;
  const BOTANICALS = ingredients.botanicals;
  const TOP = ingredients.mixer;
  const RICH_SPIRITS = ['Whiskey', 'Bourbon', 'Cognac'];
  const LEAN_VALUES = {};
  const LEAN_OPTIONS = [...new Set([...CITRUS, ...JUICE, ...SYRUP, ...PUREE].filter(item => item !== 'None'))];
  const aliases = {
    'aged rum': 'dark rum',
    'dark aged rum': 'dark rum',
    'blanco tequila': 'tequila',
    'citrus vodka': 'vodka',
    'gin or vodka': 'vodka-gin',
    'vodka/gin': 'vodka-gin',
    'rye whiskey': 'whiskey',
    'scotch whisky': 'whiskey',
    'irish whiskey': 'whiskey',
    'blended scotch whisky': 'whiskey',
    'peated scotch': 'whiskey',
    'lemon juice': 'lemon',
    'lime juice': 'lime',
    'lime wedges': 'lime',
    'orange juice': 'orange',
    'pineapple juice': 'pineapple',
    'cranberry juice': 'cranberry',
    'pink grapefruit juice': 'grapefruit',
    'agave syrup': 'agave',
    'coconut syrup': 'coconut',
    'vanilla syrup': 'vanilla',
    'maple syrup': 'maple',
    'honey syrup': 'honey',
    'honey and ginger syrup': 'honey',
    'sugar syrup': 'sugar syrup',
    'soda water': 'soda',
    'club soda': 'soda',
    tonic: 'tonic water',
    prosecco: 'sparkling wine',
    champagne: 'sparkling wine',
    'passion fruit puree': 'passion fruit',
    'peach puree': 'peach',
    'mango puree': 'mango',
    'strawberry puree': 'strawberry'
  };
  const normalize = value => {
    const cleaned = value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
    return aliases[cleaned] || cleaned;
  };
  const evidence = new Map(evidencePairs.map(pair => [[`${pair.a_category.toLowerCase()}|${normalize(pair.a_ingredient)}`, `${pair.b_category.toLowerCase()}|${normalize(pair.b_ingredient)}`].sort().join('::'), pair.count]));
  const evidenceLookup = (a, b) => evidence.get([`${a.category.toLowerCase()}|${normalize(a.ingredient)}`, `${b.category.toLowerCase()}|${normalize(b.ingredient)}`].sort().join('::')) || 0;

  // Aperitif & Liqueur options
  const APERITIF_LIQUEUR_OPTIONS = ['Aperol', 'Campari', 'Sweet Vermouth', 'Dry Vermouth', 'Amaretto', 'Elderflower Liqueur', 'Orange Liqueur', 'Midori', 'Crème de Cassis', 'Nectarine', 'RinQuinQuin'];

  // Syrup categories
  const SYRUP_CATEGORIES = {
    'Natural Sugar': ['None', 'Sugar syrup', 'Honey', 'Agave'],
    'Fruit & Citrus Syrups': ['Grenadine'],
    'Spice, Nut & Floral Syrups': ['Orgeat', 'Vanilla', 'Coconut', 'Falernum', 'Maple', 'Elderflower', 'Cinnamon', 'Caramel']
  };

  const GARNISH = {
    citrus: ['Citrus peel, expressed and discarded', 'Citrus peel, expressed and kept in the glass'],
    fruit: ['Fruit slice on the rim'],
    top: ['Fruit wheel floated on top', 'A dusting over the foam or top'],
    none: ['No garnish']
  };

  let state = {
    spirits: [],
    citrus: CITRUS.find(item => item !== 'None') || 'None',
    juices: [JUICE.find(item => item !== 'None') || 'None'],
    syrup: SYRUP.find(item => item !== 'None') || 'None',
    puree: 'None',
    botanical: 'None',
    top: TOP[0],
    unit: 'ml',
    garnishIndex: 0,
    version: 'classic',
    openSpiritCategories: { 'Aperitif & Liqueur': true },
    openSyrupCategories: {} // Track which categories are open
  };

  let similarCocktailsOpen = false;
  let builderMode = 'guided';
  const freeformRows = [
    { category: 'Spirit', label: 'Spirit', hasSecond: true },
    { category: 'Citrus', label: 'Citrus', hasSecond: false },
    { category: 'Juice', label: 'Juice', hasSecond: true },
    { category: 'Syrup', label: 'Syrup', hasSecond: true },
    { category: 'Puree', label: 'Purée', hasSecond: false },
    { category: 'Botanical', label: 'Botanical', hasSecond: false, noAmount: true },
    { category: 'Liqueur', label: 'Liqueur', hasSecond: true },
    { category: 'Top', label: 'Top', hasSecond: false, noAmount: true }
  ];
  const freeformLiqueurOptions = [...new Set([...ingredients.liqueur, ...APERITIF_LIQUEUR_OPTIONS])].sort();
  const freeformOptions = { Spirit: SPIRITS, Citrus: CITRUS.filter(item => item !== 'None'), Juice: JUICE.filter(item => item !== 'None'), Syrup: SYRUP.filter(item => item !== 'None'), Puree: PUREE.filter(item => item !== 'None'), Botanical: BOTANICALS.filter(item => item !== 'None'), Liqueur: freeformLiqueurOptions, Top: TOP.filter(item => item !== 'None'), Bitters: ingredients.bitters, Foamer: ingredients.foamer };

  // Initialize all categories as open
  Object.keys(SYRUP_CATEGORIES).forEach(cat => {
    state.openSyrupCategories[cat] = true;
  });

  function richSpiritSelected() {
    return state.spirits.some(s => RICH_SPIRITS.includes(s));
  }

  function chip(label, selected, disabled, onClick) {
    const el = document.createElement('div');
    el.className = 'byoc-chip' + (selected ? ' selected' : '') + (disabled ? ' disabled' : '');
    el.textContent = label;
    if (!disabled) el.onclick = onClick;
    return el;
  }

  function renderSpirits() {
    const box = document.getElementById('spiritChips');
    box.innerHTML = '';
    const standaloneSpirits = SPIRITS.filter(s => !APERITIF_LIQUEUR_OPTIONS.includes(s));
    const hasAperitifLiqueur = state.spirits.some(s => APERITIF_LIQUEUR_OPTIONS.includes(s));

    standaloneSpirits.forEach(s => {
      const selected = state.spirits.includes(s);
      const atCap = state.spirits.length >= 2 && !selected;
      box.appendChild(chip(s, selected, atCap, () => {
        if (selected) {
          state.spirits = state.spirits.filter(x => x !== s);
        } else if (state.spirits.length < 2) {
          state.spirits.push(s);
        }
        render();
      }));
    });

    const catContainer = document.getElementById('spiritCategories');
    if (catContainer) {
      catContainer.innerHTML = '';

      const categoryDiv = document.createElement('div');
      categoryDiv.className = 'byoc-category-group byoc-category-group--aperitif';

      const selectedInCategory = APERITIF_LIQUEUR_OPTIONS.filter(opt => state.spirits.includes(opt));
      const isOpen = state.openSpiritCategories['Aperitif & Liqueur'];

      const header = document.createElement('div');
      header.className = 'byoc-category-header' + (isOpen ? ' open' : '');

      const toggle = document.createElement('span');
      toggle.className = 'byoc-category-header-toggle';

      const label = document.createElement('span');
      label.className = 'byoc-category-header-label';
      label.textContent = 'Aperitif & Liqueur';

      const indicator = document.createElement('span');
      indicator.className = 'byoc-category-indicator';
      if (selectedInCategory.length > 0 && !isOpen) {
        indicator.textContent = '✓ ' + selectedInCategory.join(', ');
      }

      header.appendChild(toggle);
      header.appendChild(label);
      if (indicator.textContent) header.appendChild(indicator);

      header.onclick = () => {
        state.openSpiritCategories['Aperitif & Liqueur'] = !state.openSpiritCategories['Aperitif & Liqueur'];
        renderSpirits();
      };

      categoryDiv.appendChild(header);

      const chipsDiv = document.createElement('div');
      chipsDiv.className = 'byoc-category-chips' + (!isOpen ? ' collapsed' : '');

      APERITIF_LIQUEUR_OPTIONS.forEach(option => {
        const selected = state.spirits.includes(option);
        const disabled = !selected && (state.spirits.length >= 2 || hasAperitifLiqueur);
        const chipEl = chip(option, selected, disabled, () => {
          if (selected) {
            state.spirits = state.spirits.filter(x => x !== option);
          } else if (state.spirits.length < 2 && !hasAperitifLiqueur) {
            state.spirits.push(option);
          }
          render();
        });
        chipsDiv.appendChild(chipEl);
      });

      categoryDiv.appendChild(chipsDiv);
      catContainer.appendChild(categoryDiv);
    }

    document.getElementById('spiritHelp').textContent =
      state.spirits.length >= 2 ? 'Slot full — deselect one to swap it out.' : (hasAperitifLiqueur ? 'At most 1 Aperitif/Liqueur allowed — pair it with a base spirit.' : '');
  }

  function renderCitrus() {
    const box = document.getElementById('citrusChips');
    box.innerHTML = '';
    CITRUS.forEach(c => {
      const selected = state.citrus === c;
      box.appendChild(chip(c, selected, false, () => {
        state.citrus = c;
        render();
      }));
    });
    document.getElementById('citrusHelp').textContent = '';
  }

  function renderJuice() {
    const box = document.getElementById('juiceChips');
    box.innerHTML = '';
    JUICE.forEach(j => {
      const selected = state.juices.includes(j);
      const atCap = state.juices.length >= 2 && !selected;
      const disabled = atCap;
      box.appendChild(chip(j, selected, disabled, () => {
        if (selected) state.juices = state.juices.filter(item => item !== j);
        else if (j === 'None') state.juices = ['None'];
        else state.juices = [...state.juices.filter(item => item !== 'None'), j];
        render();
      }));
    });
    document.getElementById('juiceHelp').textContent =
      state.juices.length >= 2 ? 'Slot full — deselect one to swap it out.' : '';
  }

  function renderSyrupCategories() {
    const container = document.getElementById('syrupCategories');
    container.innerHTML = '';

    Object.entries(SYRUP_CATEGORIES).forEach(([categoryName, options]) => {
      const categoryDiv = document.createElement('div');
      const categoryTheme = {
        'Natural Sugar': 'natural-sugar',
        'Fruit & Citrus Syrups': 'fruit-citrus',
        'Spice, Nut & Floral Syrups': 'spice-nut-floral'
      }[categoryName];
      categoryDiv.className = `byoc-category-group byoc-category-group--${categoryTheme}`;

      // Find which items in this category are actually available
      const availableOptions = options.filter(opt => SYRUP.includes(opt));
      if (availableOptions.length === 0) return; // Skip empty categories

      // Check if any option in this category is selected
      const selectedInCategory = availableOptions.find(opt => state.syrup === opt);

      // Create category header
      const header = document.createElement('div');
      header.className = 'byoc-category-header' + (state.openSyrupCategories[categoryName] ? ' open' : '');
      
      const toggle = document.createElement('span');
      toggle.className = 'byoc-category-header-toggle';
      
      const label = document.createElement('span');
      label.className = 'byoc-category-header-label';
      label.textContent = categoryName;
      
      const indicator = document.createElement('span');
      indicator.className = 'byoc-category-indicator';
      if (selectedInCategory && !state.openSyrupCategories[categoryName]) {
        indicator.textContent = '✓ ' + selectedInCategory;
      }

      header.appendChild(toggle);
      header.appendChild(label);
      if (indicator.textContent) header.appendChild(indicator);
      
      header.onclick = () => {
        state.openSyrupCategories[categoryName] = !state.openSyrupCategories[categoryName];
        renderSyrupCategories();
      };

      categoryDiv.appendChild(header);

      // Create chips container
      const chipsDiv = document.createElement('div');
      chipsDiv.className = 'byoc-category-chips' + (!state.openSyrupCategories[categoryName] ? ' collapsed' : '');

      availableOptions.forEach(option => {
        const selected = state.syrup === option;
        const chipEl = chip(option, selected, false, () => {
          state.syrup = option;
          render();
        });
        chipsDiv.appendChild(chipEl);
      });

      categoryDiv.appendChild(chipsDiv);
      container.appendChild(categoryDiv);
    });
  }

  function renderTop() {
    const box = document.getElementById('topChips');
    box.innerHTML = '';
    TOP.forEach(t => box.appendChild(chip(t, state.top === t, false, () => {
      state.top = t;
      render();
    })));
  }

  function renderPuree() {
    const box = document.getElementById('pureeChips');
    box.innerHTML = '';
    PUREE.forEach(p => box.appendChild(chip(p, state.puree === p, false, () => {
      state.puree = p;
      render();
    })));
  }

  function renderBotanicals() {
    const box = document.getElementById('botanicalChips');
    box.innerHTML = '';
    BOTANICALS.forEach(b => box.appendChild(chip(b, state.botanical === b, false, () => {
      state.botanical = b;
      render();
    })));
  }

  function fmt(ml) {
    if (state.unit === 'ml') return Math.round(ml) + 'ml';
    return mlToOz(ml).toFixed(2).replace(/\.?0+$/, '') + 'oz';
  }

  // 30ml = 1oz. oz rounds up to the nearest quarter-ounce (a usable bar measure); ml stays precise.
  function mlToOz(ml) {
    return Math.ceil((ml / 30) * 4) / 4;
  }

  function ozToMl(oz) {
    return Math.round(oz * 30);
  }

  // Toggle-driven auto-conversion: mathematically accurate, rounded to 1 decimal — never snapped to the 0.5oz manual-entry grid.
  function mlToOzExact(ml) {
    return Math.round((ml / 30) * 10) / 10;
  }

  function ozToMlExact(oz) {
    return Math.round(oz * 30 * 10) / 10;
  }

  function computeSpec() {
    const spiritTotal = state.spirits.length === 1 ? 45 : 50;
    const perSpirit = spiritTotal / state.spirits.length;
    const hasCitrus = state.citrus !== 'None';
    const hasPuree = state.puree !== 'None';
    const juices = state.juices.filter(item => item !== 'None');
    return {
      spiritTotal,
      perSpirit,
      citrusAmt: hasCitrus ? 15 : 0,
      juiceAmt: juices.length ? 20 / juices.length : 0,
      syrupAmt: hasPuree ? 10 : 20,
      pureeAmt: hasPuree ? 25 : 0
    };
  }

  function glassFor() {
    if (state.top === 'Soda' || state.top === 'Tonic Water' || state.top === 'Grapefruit Soda') return 'Highball';
    if (state.top === 'Sparkling Wine') return 'Flute';
    if (state.top === 'Foamer') return 'Coupe';
    if (state.top === 'Cola' || state.top === 'Ginger Beer' || state.top === 'Lemonade') return 'Highball';
    return 'Nick and Nora';
  }

  function iceFor() {
    const glass = glassFor();
    if (glass === 'Coupe' || glass === 'Nick and Nora' || glass === 'Flute') return 'None';
    if (glass === 'Tiki') return 'Crushed';
    return 'Cubed';
  }

  function methodFor() {
    const glass = glassFor();
    if (glass === 'Rocks' && state.citrus === 'None' && state.juices.includes('None')) return 'Stir';
    if (glass === 'Highball') return 'Shake & Strain';
    return 'Shake & Strain';
  }

  function currentGarnishList() {
    const list = [];
    const hasCitrus = state.citrus !== 'None' || state.juices.some(juice => juice !== 'None');
    const hasTop = state.top !== 'None';
    if (hasCitrus || !hasTop) list.push(...GARNISH.citrus);
    if (hasCitrus) list.push(...GARNISH.fruit);
    if (hasTop) list.push(...GARNISH.top);
    list.push(...GARNISH.none);
    return list;
  }

  function freeformIngredientField(category, label, entry, placeholder) {
    const listId = `freeform-list-${category}-${entry}`.toLowerCase();
    return `
      <div class="byoc-freeform-input-wrap">
        <input class="byoc-freeform-input" data-category="${category}" data-entry="${entry}" placeholder="${placeholder || label}" aria-label="${label}" autocomplete="off">
        <div class="byoc-suggestion-list" id="${listId}-suggestions" hidden></div>
      </div>
    `;
  }

  function updateFreeformSuggestions(input) {
    const category = input.dataset.category;
    const list = input.parentElement.querySelector('.byoc-suggestion-list');
    const options = freeformOptions[category] || [];
    const value = input.value.trim().toLowerCase();
    const matches = (!value)
      ? options.slice(0, 8)
      : options.filter(option => option.toLowerCase().includes(value)).slice(0, 8);

    if (!matches.length) {
      list.hidden = true;
      list.innerHTML = '';
      return;
    }

    list.innerHTML = matches.map(option => `
      <button type="button" class="byoc-suggestion-item" data-value="${option}">${option}</button>
    `).join('');

    list.querySelectorAll('.byoc-suggestion-item').forEach(item => {
      item.addEventListener('mousedown', (event) => {
        event.preventDefault();
        input.value = item.dataset.value;
        list.hidden = true;
        renderFreeformResult();
        input.focus();
      });
    });

    list.hidden = false;
  }

  function freeformAmountField(category, entry) {
    return `<div class="byoc-amount-field"><input type="number" min="0" step="0.5" data-amount="${category}" data-entry="${entry}" placeholder="" aria-label="${category} amount"><span class="byoc-amount-unit">${state.unit}</span></div>`;
  }

  function renderFreeformFields() {
    const fields = document.getElementById('freeformFields');
    const categoryCells = freeformRows.map(row => {
      const primary = `<div class="byoc-freeform-field${row.noAmount ? ' byoc-freeform-field--single' : ''}">${freeformIngredientField(row.category, row.label, '1')}${row.noAmount ? '' : freeformAmountField(row.category, '1')}</div>`;
      const second = row.hasSecond
        ? `<div class="byoc-freeform-field byoc-freeform-field--second">${freeformIngredientField(row.category, row.label, '2', `+ second ${row.label.toLowerCase()}`)}${freeformAmountField(row.category, '2')}</div>`
        : '';
      return `<div class="byoc-freeform-category">${primary}${second}</div>`;
    });
    // Bitters and Foamer are recipe-completion fields only — a discrete choice, never a measured amount, and never part of matching.
    const bittersCell = `<div class="byoc-freeform-category"><div class="byoc-freeform-field byoc-freeform-field--choice">${freeformIngredientField('Bitters', 'Bitters', '1')}<select data-dash aria-label="Bitters dash"><option value="Single dash">Single dash</option><option value="Double dash">Double dash</option></select></div></div>`;
    const foamerCell = `<div class="byoc-freeform-category"><div class="byoc-freeform-field byoc-freeform-field--choice">${freeformIngredientField('Foamer', 'Foamer', '1')}<select data-foamer-included aria-label="Foamer included"><option value="Not included">Not included</option><option value="Included">Included</option></select></div></div>`;

    fields.innerHTML = categoryCells.join('') + bittersCell + foamerCell;
    fields.querySelectorAll('.byoc-freeform-input').forEach(input => {
      input.addEventListener('input', () => {
        updateFreeformSuggestions(input);
        renderFreeformResult();
      });
      input.addEventListener('focus', () => updateFreeformSuggestions(input));
      input.addEventListener('blur', () => {
        window.setTimeout(() => {
          const list = input.parentElement?.querySelector('.byoc-suggestion-list');
          if (list) list.hidden = true;
        }, 120);
      });
    });
    fields.querySelectorAll('select').forEach(el => el.addEventListener('change', renderFreeformResult));
    document.querySelectorAll('#freeformGlass, #freeformIce, #freeformMethod').forEach(input => input.addEventListener('change', renderFreeformResult));
    applyFreeformAmountDefaults();
  }

  function amountForUnit(mlAmount) {
    return state.unit === 'ml' ? mlAmount : mlToOzExact(mlAmount);
  }

  function applyDefaultAmount(category, entry, amountMl) {
    const amountInput = document.querySelector(`#freeformFields input[data-amount="${category}"][data-entry="${entry}"]`);
    if (!amountInput) return;
    if (amountInput.dataset.touched === 'true') return;
    amountInput.value = String(amountForUnit(amountMl));
  }

  function applyFreeformAmountDefaults() {
    const pureeInput = document.querySelector('#freeformFields input[data-category="Puree"][data-entry="1"]');
    const hasPuree = Boolean(pureeInput && pureeInput.value.trim());
    applyDefaultAmount('Syrup', '1', hasPuree ? 10 : 20);
    if (hasPuree) applyDefaultAmount('Puree', '1', 25);
  }

  function freeformBuild() {
    return [...document.querySelectorAll('#freeformFields input[data-category]')]
      .filter(input => input.dataset.category !== 'Bitters' || input.value.trim())
      .filter(input => input.dataset.category !== 'Foamer' || (input.value.trim() && document.querySelector('#freeformFields select[data-foamer-included]').value === 'Included'))
      .map(input => {
        const category = input.dataset.category;
        const entry = input.dataset.entry;
        const amountInput = document.querySelector(`#freeformFields input[data-amount="${category}"][data-entry="${entry}"]`);
        const rawAmount = amountInput ? parseFloat(amountInput.value) : NaN;
        const amountMl = Number.isNaN(rawAmount) ? null : (state.unit === 'oz' ? ozToMl(rawAmount) : rawAmount);
        return { category, ingredient: input.value.trim(), amountMl };
      }).filter(item => item.ingredient);
  }

  function freeformSpecLines() {
    const lines = [];
    document.querySelectorAll('#freeformFields input[data-category]').forEach(input => {
      const name = input.value.trim();
      if (!name) return;
      if (input.dataset.category === 'Bitters') {
        const dash = document.querySelector('#freeformFields select[data-dash]').value;
        lines.push(`${name} — ${dash}`);
        return;
      }
      if (input.dataset.category === 'Foamer') {
        if (document.querySelector('#freeformFields select[data-foamer-included]').value === 'Included') lines.push(name);
        return;
      }
      const amountInput = document.querySelector(`#freeformFields input[data-amount="${input.dataset.category}"][data-entry="${input.dataset.entry}"]`);
      const amount = amountInput ? amountInput.value : '';
      lines.push(`${name}${amount ? ` ${amount}${state.unit}` : ''}`);
    });
    return lines;
  }

  function freeformRatioDescriptor(build) {
    const measured = build.filter(item => item.category !== 'Bitters' && item.category !== 'Foamer' && item.amountMl && item.amountMl > 0);
    if (!measured.length) return '';

    const total = measured.reduce((sum, item) => sum + item.amountMl, 0);
    const spirit = measured.filter(item => item.category === 'Spirit').reduce((sum, item) => sum + (item.amountMl || 0), 0);
    const sour = measured.filter(item => item.category === 'Citrus' || item.category === 'Juice').reduce((sum, item) => sum + (item.amountMl || 0), 0);
    const sweet = measured.filter(item => item.category === 'Syrup' || item.category === 'Puree').reduce((sum, item) => sum + (item.amountMl || 0), 0);
    const hasTop = build.some(item => item.category === 'Top' && item.ingredient && item.ingredient !== 'None');

    const spiritLabel = spirit / total >= 0.45 ? 'Spirit-forward' : 'Easy-drinking';
    const sweetnessLabel = sweet > sour ? 'sweet-leaning' : sour > sweet ? 'dry' : 'balanced';
    const lengthLabel = hasTop || total >= 220 ? 'long' : total <= 130 ? 'short' : 'balanced';

    const descriptor = `${spiritLabel} and ${sweetnessLabel}`;
    return lengthLabel === 'balanced' ? descriptor : `${descriptor} ${lengthLabel}`;
  }

  function renderFreeformResult() {
    applyFreeformAmountDefaults();
    const build = freeformBuild();
    const anyFieldFilled = [...document.querySelectorAll('#freeformFields input[data-category]')].some(input => input.value.trim());
    const result = document.getElementById('freeformResult');
    if (!anyFieldFilled) { result.innerHTML = '<p>Enter ingredients to see the closest matches.</p>'; return; }

    const closestMatch = suggestionNames(build)[0] || null;
    const descriptor = freeformRatioDescriptor(build);
    const spec = freeformSpecLines().join('\n');

    result.innerHTML = `
      ${descriptor ? `<p class="byoc-freeform-ratio">${descriptor}</p>` : ''}
      ${closestMatch ? `<h3>${closestMatch}</h3>` : ''}
      <p class="byoc-freeform-spec">${spec}\nGlass: ${document.getElementById('freeformGlass').value}\nIce: ${document.getElementById('freeformIce').value}\nMethod: ${document.getElementById('freeformMethod').value}</p>
    `;
  }

  function setBuilderMode(mode) {
    builderMode = mode;
    document.getElementById('guidedPanel').style.display = mode === 'guided' ? 'block' : 'none';
    document.getElementById('freeformPanel').classList.toggle('open', mode === 'freeform');
    document.getElementById('byocPage').classList.toggle('freeform-active', mode === 'freeform');
    document.getElementById('guidedModeBtn').className = mode === 'guided' ? 'active' : '';
    document.getElementById('freeformModeBtn').className = mode === 'freeform' ? 'active' : '';
    if (mode === 'freeform') renderFreeformResult();
  }

  function outcomeBuild() {
    const spec = computeSpec();
    return [
      ...state.spirits.map(ingredient => ({ category: 'Spirit', ingredient, amountMl: spec.perSpirit })),
      { category: 'Citrus', ingredient: state.citrus, amountMl: spec.citrusAmt },
      ...state.juices.map(ingredient => ({ category: 'Juice', ingredient, amountMl: spec.juiceAmt })),
      { category: 'Syrup', ingredient: state.syrup, amountMl: spec.syrupAmt },
      ...(state.puree !== 'None' ? [{ category: 'Puree', ingredient: state.puree, amountMl: spec.pureeAmt }] : []),
      ...(state.botanical !== 'None' ? [{ category: 'Botanical', ingredient: state.botanical, amountMl: null }] : []),
      ...(state.top !== 'None' ? [{ category: 'Top', ingredient: state.top, amountMl: null }] : [])
    ];
  }

  function computeFlavorLean() {
    const selected = [state.syrup, state.puree, state.citrus, ...state.juices].filter(item => item && item !== 'None');
    const missing = LEAN_OPTIONS.filter(item => typeof LEAN_VALUES[item] !== 'number');
    const total = missing.length ? 0 : selected.reduce((sum, item) => sum + LEAN_VALUES[item], 0);
    return { total, missing, hasValues: selected.length > 0 && missing.length === 0 };
  }

  function renderFlavorLean() {
    const lean = computeFlavorLean();
    const knownValues = Object.values(LEAN_VALUES);
    const maximumLean = knownValues.length ? Math.max(...knownValues.map(value => Math.abs(value))) : 0;
    const magnitude = maximumLean ? Math.abs(lean.total) / maximumLean : 0;
    const stop = magnitude === 0 ? 0 : magnitude <= 0.25 ? 0.5 : magnitude <= 0.5 ? 0.75 : magnitude <= 0.75 ? 0.8 : 1;
    const position = !lean.hasValues || lean.total === 0 ? 50 : lean.total > 0 ? 50 + (50 * stop) : 50 - (50 * stop);
    document.getElementById('flavorSlider').style.setProperty('--slider-position', `${position}%`);
    document.getElementById('sliderPending').textContent = lean.missing.length
      ? `Flavor lean values pending for: ${lean.missing.join(', ')}.`
      : '';
  }

  function renderSpec(build) {
    const spec = computeSpec();
    const lines = [];
    build.filter(item => item.category === 'Spirit').forEach(item => {
      lines.push(`${item.ingredient} <span class="amt">${fmt(spec.perSpirit)}</span>`);
    });
    const citrus = build.find(item => item.category === 'Citrus' && item.ingredient !== 'None');
    const juices = build.filter(item => item.category === 'Juice' && item.ingredient !== 'None');
    if (citrus) {
      lines.push(`${citrus.ingredient} juice <span class="amt">${fmt(spec.citrusAmt)}</span>`);
    }
    juices.forEach(juice => {
      lines.push(`${juice.ingredient} juice <span class="amt">${fmt(spec.juiceAmt)}</span>`);
    });
    const syrup = build.find(item => item.category === 'Syrup' && item.ingredient !== 'None');
    if (syrup) {
      lines.push(`${syrup.ingredient} <span class="amt">${fmt(spec.syrupAmt)}</span>`);
    }
    const puree = build.find(item => item.category === 'Puree' && item.ingredient !== 'None');
    if (puree) {
      lines.push(`${puree.ingredient} purée <span class="amt">${fmt(spec.pureeAmt)}</span>`);
    }
    const botanical = build.find(item => item.category === 'Botanical' && item.ingredient !== 'None');
    if (botanical) {
      lines.push(botanical.ingredient);
    }
    if (state.top !== 'None') lines.push(`Top ${state.top.toLowerCase()}`);
    document.getElementById('specList').innerHTML = lines.join('<br>');
  }

  function renderChanges(changes) {
    const list = document.getElementById('changeList');
    list.classList.toggle('empty', changes.length === 0);
    list.innerHTML = changes.length
      ? changes.map(change => `<div>${change.to}, swapped in for ${change.from}</div>`).join('')
      : '<div>No changes suggested</div>';
  }

  function outcomeScores(build) {
    const filled = build.filter(item => item.ingredient && item.ingredient !== 'None');
    return filled.map((ingredient, index) => {
      const others = filled.filter((_, otherIndex) => otherIndex !== index);
      return { ingredient, average: others.length ? others.reduce((sum, other) => sum + evidenceLookup(ingredient, other), 0) / others.length : 0 };
    });
  }

  function confidenceLabel(score) {
    return score >= 4 ? 'Well-evidenced' : score > 0 ? 'Rare pairing' : 'No data yet';
  }

  function nudgeBuild(originalBuild, alternatives) {
    const build = [...originalBuild];
    const changes = [];
    while (changes.length < 2) {
      const scores = outcomeScores(build).sort((a, b) => a.average - b.average);
      const weakest = scores.length > 1 && scores[0].average < scores.slice(1).map(score => score.average).sort((a, b) => a - b)[Math.floor((scores.length - 1) / 2)] ? scores[0] : null;
      if (!weakest) break;
      const index = build.findIndex(item => item === weakest.ingredient);
      const candidates = (alternatives[weakest.ingredient.category] || []).filter(candidate => candidate !== 'None' && candidate !== weakest.ingredient.ingredient).map(candidate => {
        const replacement = { category: weakest.ingredient.category, ingredient: candidate };
        const rest = build.filter((_, buildIndex) => buildIndex !== index);
        return { candidate, average: rest.length ? rest.reduce((sum, other) => sum + evidenceLookup(replacement, other), 0) / rest.length : 0 };
      }).sort((a, b) => b.average - a.average);
      if (!candidates.length || candidates[0].average <= weakest.average) break;
      build[index] = { category: weakest.ingredient.category, ingredient: candidates[0].candidate };
      changes.push({ from: weakest.ingredient.ingredient, to: candidates[0].candidate });
    }
    return { build, changes };
  }

  function suggestionNames(build) {
    const aperitifNames = new Set(APERITIF_LIQUEUR_OPTIONS.map(normalize));
    const botanicalNames = new Set(BOTANICALS.filter(item => item !== 'None').map(normalize));
    const citrusNames = new Set(CITRUS.filter(item => item !== 'None').map(normalize));
    const juiceNames = new Set(JUICE.filter(item => item !== 'None').map(normalize));
    const syrupNames = new Set(SYRUP.filter(item => item !== 'None').map(normalize));
    const pureeNames = new Set(PUREE.filter(item => item !== 'None').map(normalize));
    const topNames = new Set(TOP.filter(item => item !== 'None').map(normalize));

    const roleBasedCategory = ingredient => {
      const role = ingredient.role.toLowerCase();
      if (role.includes('garnish')) return null;
      if (role.includes('base spirit') || role.includes('spirit')) return 'Spirit';
      if (role.includes('citrus')) return 'Citrus';
      if (role.includes('juice')) return 'Juice';
      if (role.includes('syrup') || role.includes('sweetener')) return 'Syrup';
      if (role.includes('puree')) return 'Puree';
      if (role.includes('herb')) return 'Botanical';
      if (role === 'ingredient') return null;
      if (role.includes('liqueur') || role.includes('aperitif') || role.includes('amaro') || role.includes('bitter liqueur')) return 'Liqueur';
      if (role.includes('mixer') || role.includes('sparkling wine')) return 'Top';
      if (role.includes('bitters')) return 'Bitters';
      if (role.includes('foamer')) return 'Foamer';
      return null;
    };

    const inferCategoryFromName = name => {
      const normalizedName = normalize(name);
      if (botanicalNames.has(normalizedName)) return 'Botanical';
      if (citrusNames.has(normalizedName)) return 'Citrus';
      if (juiceNames.has(normalizedName)) return 'Juice';
      if (syrupNames.has(normalizedName)) return 'Syrup';
      if (pureeNames.has(normalizedName)) return 'Puree';
      if (topNames.has(normalizedName) || normalizedName === 'sparkling wine') return 'Top';
      return null;
    };

    const roleFor = ingredient => {
      if (ingredient.role.toLowerCase().includes('garnish')) return 'Excluded';
      const roleCategory = roleBasedCategory(ingredient);
      if (roleCategory) return roleCategory;
      return inferCategoryFromName(ingredient.name);
    };

    const spiritSet = value => {
      const spirit = normalize(value);
      if (spirit === 'vodka-gin') return new Set(['vodka', 'gin']);
      return new Set([spirit]);
    };

    const spiritsMatch = (a, b) => {
      const aSet = spiritSet(a);
      const bSet = spiritSet(b);
      return [...aSet].some(value => bSet.has(value));
    };

    const buildCategory = item => item.category === 'Spirit' && aperitifNames.has(normalize(item.ingredient)) ? 'Liqueur' : item.category;
    const sameIngredient = (selection, ingredient) => {
      if (buildCategory(selection) !== roleFor(ingredient)) return false;
      return buildCategory(selection) === 'Spirit'
        ? spiritsMatch(selection.ingredient, ingredient.name)
        : normalize(selection.ingredient) === normalize(ingredient.name);
    };
    const selected = build.filter(item => item.ingredient).map(item => ({ ...item, category: buildCategory(item) }));
    const byCategory = category => selected.filter(item => item.category === category);
    let candidates = suggestionCocktails.filter(cocktail => cocktail.approved_for_suggestion === true);
    let matchedAnyGate = false;

    for (const category of ['Spirit', 'Citrus', 'Juice', 'Syrup', 'Liqueur', 'Puree', 'Botanical', 'Top', 'Bitters', 'Foamer']) {
      const selections = byCategory(category);
      if (!selections.length) continue;
      const hasNone = selections.some(item => item.ingredient === 'None');
      const chosen = selections.filter(item => item.ingredient !== 'None');
      const filtered = candidates.filter(cocktail => {
        const ingredients = cocktail.ingredients.filter(ingredient => roleFor(ingredient) === category);
        if (hasNone && ingredients.length) return false;
        return chosen.every(selection => ingredients.some(ingredient => sameIngredient(selection, ingredient)));
      });

      if (filtered.length) {
        candidates = filtered;
        matchedAnyGate = true;
      } else if (category === 'Spirit' && chosen.length === 1) {
        return [];
      }
    }

    if (!matchedAnyGate) return [];
    const measured = selected.filter(item => item.amountMl && item.amountMl > 0 && item.ingredient !== 'None');
    const buildTotal = measured.reduce((total, item) => total + item.amountMl, 0);
    const ratioDistance = cocktail => {
      const ingredients = cocktail.ingredients;
      const cocktailTotal = ingredients.reduce((total, ingredient) => total + (ingredient.amount || 0), 0);
      if (!buildTotal || !cocktailTotal) return 0;
      return measured.reduce((distance, selection) => {
        const ingredient = ingredients.find(candidate => sameIngredient(selection, candidate));
        if (!ingredient?.amount) return distance;
        return distance + Math.abs((selection.amountMl / buildTotal) - (ingredient.amount / cocktailTotal));
      }, 0);
    };

    return candidates
      .sort((a, b) => ratioDistance(a) - ratioDistance(b) || a.name.localeCompare(b.name))
      .slice(0, 1)
      .map(cocktail => cocktail.name);
  }

  function renderOutcome() {
    const build = outcomeBuild();
    const alternatives = {
      Spirit: SPIRITS,
      Citrus: CITRUS,
      Juice: JUICE,
      Syrup: SYRUP,
      Botanical: BOTANICALS,
      Liqueur: []
    };
    const nudge = nudgeBuild(build, alternatives);

    const suggestions = suggestionNames(nudge.build);
    const list = document.getElementById('similarCocktailsList');
    list.innerHTML = suggestions.length
      ? suggestions.map(suggestion => `<span>${suggestion}</span>`).join('')
      : '<span>No suggestions are approved yet.</span>';
    list.classList.toggle('open', similarCocktailsOpen);
  }

  function cycleGarnish(dir) {
    const list = currentGarnishList();
    state.garnishIndex = (state.garnishIndex + dir + list.length) % list.length;
    document.getElementById('garnishText').textContent = list[state.garnishIndex];
  }

  function renderResult(resetVersion) {
    renderOutcome();
    renderFlavorLean();

    if (!state.spirits.length) {
      document.getElementById('cocktailBuilt').textContent = '';
      document.getElementById('specList').innerHTML = '';
      renderChanges([]);
      document.getElementById('garnishText').textContent = '';
      return;
    }

    const nudge = nudgeBuild(outcomeBuild(), {
      Spirit: SPIRITS,
      Citrus: CITRUS,
      Juice: JUICE,
      Syrup: SYRUP,
      Botanical: BOTANICALS,
      Liqueur: []
    });
    const originalBuild = outcomeBuild();
    const originalJuices = originalBuild.filter(item => item.category === 'Juice' && item.ingredient !== 'None');
    const originalCitrus = originalBuild.find(item => item.category === 'Citrus' && item.ingredient !== 'None');
    const originalPuree = originalBuild.find(item => item.category === 'Puree' && item.ingredient !== 'None');
    const originalBotanical = originalBuild.find(item => item.category === 'Botanical' && item.ingredient !== 'None');
    const builtFrom = [...originalBuild.filter(item => item.category === 'Spirit').map(item => item.ingredient), originalCitrus?.ingredient, ...originalJuices.map(item => item.ingredient), originalPuree?.ingredient, originalBotanical?.ingredient]
      .filter(Boolean).join(' · ');
    document.getElementById('cocktailBuilt').textContent = 'Built from: ' + builtFrom;

    renderSpec(originalBuild);
    renderChanges(nudge.changes);

    state.garnishIndex = 0;
    document.getElementById('garnishText').textContent = currentGarnishList()[0];
  }

  function render() {
    renderSpirits();
    renderCitrus();
    renderJuice();
    renderSyrupCategories();
    renderPuree();
    renderBotanicals();
    renderTop();
    renderResult(true);
  }

  // Event listeners
  document.getElementById('similarCocktailsToggle').onclick = () => {
    similarCocktailsOpen = !similarCocktailsOpen;
    document.getElementById('similarCocktailsList').classList.toggle('open', similarCocktailsOpen);
  };
  document.getElementById('guidedModeBtn').onclick = () => setBuilderMode('guided');
  document.getElementById('freeformModeBtn').onclick = () => setBuilderMode('freeform');

  document.getElementById('mlBtn').onclick = () => setUnit('ml');
  document.getElementById('ozBtn').onclick = () => setUnit('oz');

  function setUnit(u) {
    const previousUnit = state.unit;
    if (u !== previousUnit) {
      document.querySelectorAll('#freeformFields input[data-amount]').forEach(input => {
        const raw = parseFloat(input.value);
        if (Number.isNaN(raw)) return;
        input.value = previousUnit === 'ml' ? mlToOzExact(raw) : ozToMlExact(raw);
      });
    }
    state.unit = u;
    document.getElementById('mlBtn').className = u === 'ml' ? 'active' : '';
    document.getElementById('ozBtn').className = u === 'oz' ? 'active' : '';
    document.querySelectorAll('.byoc-amount-unit').forEach(label => { label.textContent = u; });
    applyFreeformAmountDefaults();
    renderResult(false);
    renderFreeformResult();
  }

  document.addEventListener('input', event => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    if (target.matches('#freeformFields input[data-amount]')) target.dataset.touched = 'true';
  });

  // Initial render
  renderFreeformFields();
  render();
</script>
