---
import Layout from '../layouts/Layout.astro';
import cocktailsData from '../../elixir_maven_cocktails.json';
import cooccurrenceData from '../../:design-reference:/files 2/cooccurrence_table.json';

// Extract ingredient categories from the JSON
const extractIngredients = () => {
  const categories = {
    spirits: new Set<string>(),
    citrus: new Set<string>(),
    juice: new Set<string>(),
    syrup: new Set<string>(),
    liqueur: new Set<string>(),
    mixer: new Set<string>(),
    bitters: new Set<string>(),
    foamer: new Set<string>()
  };

  const spiritNormalization: Record<string, string> = {
    'Aged Rum': 'Rum',
    'Blanco Tequila': 'Tequila',
    'Blended Scotch Whisky': 'Whiskey',
    'Bourbon': 'Bourbon',
    'Cachaça': 'Cachaça',
    'Citrus Vodka': 'Vodka',
    'Coconut Rum': 'Rum',
    'Cognac': 'Cognac',
    'Dark Rum': 'Rum',
    'Gin': 'Gin',
    'Gin or Vodka': 'Gin',
    'Irish Whiskey': 'Whiskey',
    'Overproof Rum': 'Rum',
    'Pisco': 'Pisco',
    'Rye Whiskey': 'Whiskey',
    'Scotch Whisky': 'Whiskey',
    'Vodka': 'Vodka',
    'Vodka/Gin': 'Vodka',
    'White Rum': 'Rum'
  };

  const citrusNormalization: Record<string, string> = {
    'Lemon Juice': 'Lemon',
    'Lime Juice': 'Lime',
    'Lime Wedges': 'Lime'
  };

  const juiceNormalization: Record<string, string> = {
    'Cranberry Juice': 'Cranberry',
    'Lemon Juice': 'Lemon',
    'Lime Juice': 'Lime',
    'Orange Juice': 'Orange',
    'Pineapple Juice': 'Pineapple',
    'Pink Grapefruit Juice': 'Grapefruit'
  };

  const syrupNormalization: Record<string, string> = {
    'Coconut Syrup': 'Coconut',
    'Falernum': 'Falernum',
    'Grenadine': 'Grenadine',
    'Honey and Ginger Syrup': 'Honey',
    'Maple Syrup': 'Maple',
    'Orgeat': 'Orgeat',
    'Sugar Syrup': 'Sugar syrup',
    'Vanilla Syrup': 'Vanilla'
  };

  const mixerNormalization: Record<string, string> = {
    'Cola': 'Cola',
    'Ginger Beer': 'Ginger Beer',
    'Grapefruit Soda': 'Soda',
    'Lemonade': 'Lemonade',
    'Soda': 'Soda',
    'Soda Water': 'Soda',
    'Tomato Juice': 'Tomato Juice'
  };

  cocktailsData.cocktails.forEach(cocktail => {
    cocktail.ingredients.forEach(ing => {
      const role = ing.role.toLowerCase();
      if (role.includes('spirit')) {
        categories.spirits.add(spiritNormalization[ing.name] || ing.name);
      } else if (role.includes('citrus')) {
        categories.citrus.add(citrusNormalization[ing.name] || ing.name);
      } else if (role.includes('juice')) {
        categories.juice.add(juiceNormalization[ing.name] || ing.name);
      } else if (role.includes('syrup')) {
        categories.syrup.add(syrupNormalization[ing.name] || ing.name);
      } else if (role.includes('liqueur')) {
        categories.liqueur.add(ing.name);
      } else if (role.includes('mixer')) {
        categories.mixer.add(mixerNormalization[ing.name] || ing.name);
      } else if (role.includes('bitters')) {
        categories.bitters.add(ing.name);
      } else if (role.includes('foamer')) {
        categories.foamer.add(ing.name);
      }
    });
  });

  return {
    spirits: Array.from(categories.spirits).sort(),
    citrus: ['None', ...Array.from(categories.citrus).sort()],
    juice: ['None', ...Array.from(categories.juice).filter(item => !['Lemon', 'Lime'].includes(item)).sort()],
    syrup: ['None', ...Array.from(categories.syrup).sort()],
    liqueur: Array.from(categories.liqueur).sort(),
    mixer: ['None', ...Array.from(categories.mixer).sort()],
    bitters: Array.from(categories.bitters).sort(),
    foamer: Array.from(categories.foamer).sort()
  };
};

const ingredients = extractIngredients();
if (!ingredients.syrup.includes('Elderflower')) ingredients.syrup.push('Elderflower');
if (!ingredients.foamer.includes('Egg White')) ingredients.foamer.unshift('Egg White');
const evidencePairs = cooccurrenceData.pairs;
const suggestionCocktails = cocktailsData.cocktails.map((cocktail) => ({
  ...cocktail,
  published: (cocktail as { published?: boolean }).published ?? true,
  approved_for_suggestion: (cocktail as { approved_for_suggestion?: boolean }).approved_for_suggestion ?? false,
}));
---

<Layout
  title="Build Your Own Cocktail — Elixir Maven"
  description="Create your own custom cocktail with our interactive builder. Mix spirits, citrus, juices, and syrups to craft the perfect drink."
>
  <style is:global define:vars={{ '--holo-pink': '#F4C6DD', '--holo-purple': '#C9AEEF', '--holo-blue': '#9FC6F0', '--holo-cyan': '#9CE7EA', '--holo-gold': '#E9C98A' }}>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,600&family=Jost:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

    :root {
      --bg: #0F0B0C;
      --panel: #1A1113;
      --cream: #F2E6D8;
      --brass: #C99A6B;
      --muted: #8a7a72;
      --border: #2a1e20;
      --chip-text: #E3D6C9;
    }

    /* ─── Holographic gradient ─── */
    @keyframes shimmer {
      0% { background-position: 0% 50%; }
      100% { background-position: 300% 50%; }
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .byoc-page {
      background: var(--bg);
      color: var(--cream);
      padding: 40px 32px 100px;
    }

    .byoc-wrap {
      max-width: 1280px;
      margin: 0 auto;
    }

    /* ─── Header ─── */
    .byoc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 30px;
      gap: 20px;
    }

    .byoc-header-block {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .byoc-wordmark {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-weight: 600;
      font-size: 72px;
      margin: 0;
      letter-spacing: 0.5px;
      line-height: 1.1;
    }

    .byoc-wordmark .elixir {
      color: var(--brass);
    }

    .byoc-wordmark .maven {
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A, #F4C6DD);
      background-size: 300% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: shimmer 16s linear infinite;
    }

    .byoc-membership {
      font-size: 13px;
      font-weight: 400;
      color: var(--cream);
      margin: 2px 0 0 0;
      letter-spacing: 0.3px;
    }

    .byoc-title {
      font-size: 15px;
      font-weight: 400;
      color: var(--muted);
      margin: 18px 0 0 0;
      letter-spacing: 0.5px;
    }

    /* ─── Toggle ─── */
    .byoc-toggle {
      display: inline-flex;
      background: var(--panel);
      border-radius: 999px;
      padding: 3px;
      gap: 2px;
    }

    .byoc-toggle button {
      padding: 6px 16px;
      font-size: 12px;
      font-family: 'IBM Plex Mono', monospace;
      border-radius: 999px;
      color: var(--muted);
      background: none;
      border: none;
      cursor: pointer;
      transition: all 0.15s;
    }

    .byoc-toggle .active {
      padding: 3px;
      border-radius: 999px;
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A, #F4C6DD);
      background-size: 400% 100%;
      background-position: 50% 50%;
    }

    .byoc-toggle .active button {
      background: var(--bg);
      color: var(--cream);
      display: block;
    }

    .byoc-toggle > div {
      border-radius: 999px;
    }

    .byoc-toggle > div:not(.active) {
      padding: 3px;
    }

    .byoc-toggle > div:not(.active) button {
      display: block;
      padding: 6px 16px;
    }

    /* ─── Category Groups ─── */
    .byoc-category-group {
      margin-bottom: 18px;
    }

    .byoc-category-header {
      font-size: 13px;
      font-weight: 500;
      padding: 8px 12px;
      border-radius: 6px;
      cursor: pointer;
      background: var(--panel2);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--chip-text);
      transition: all 0.15s;
      user-select: none;
    }

    .byoc-category-header:hover {
      background: rgba(255, 255, 255, 0.05);
    }

    /* Prism color variety for each category */
    .byoc-category-group:nth-child(1) .byoc-category-header {
      border: 1px solid rgba(244, 198, 221, 0.3);
      background: linear-gradient(135deg, rgba(244, 198, 221, 0.05), rgba(201, 174, 239, 0.04));
    }

    .byoc-category-group:nth-child(2) .byoc-category-header {
      border: 1px solid rgba(159, 198, 240, 0.3);
      background: linear-gradient(135deg, rgba(159, 198, 240, 0.05), rgba(156, 231, 234, 0.04));
    }

    .byoc-category-group:nth-child(3) .byoc-category-header {
      border: 1px solid rgba(233, 201, 138, 0.3);
      background: linear-gradient(135deg, rgba(156, 231, 234, 0.05), rgba(233, 201, 138, 0.04));
    }

    .byoc-category-header-toggle {
      display: inline-flex;
      align-items: center;
      width: 16px;
      height: 16px;
      margin-right: 8px;
      font-size: 10px;
      color: var(--brass);
    }

    .byoc-category-header.open .byoc-category-header-toggle::before {
      content: '▼';
    }

    .byoc-category-header:not(.open) .byoc-category-header-toggle::before {
      content: '▶';
    }

    .byoc-category-header-label {
      flex: 1;
    }

    .byoc-category-indicator {
      font-size: 11px;
      color: var(--brass);
      white-space: nowrap;
      margin-left: 8px;
    }

    .byoc-category-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px 12px 0;
      max-height: 500px;
      overflow: hidden;
      transition: all 0.2s;
    }

    .byoc-category-chips.collapsed {
      max-height: 0;
      padding: 0 12px;
    }

    /* ─── Layout ─── */
    .byoc-grid {
      display: flex;
      gap: 34px;
      align-items: flex-start;
      flex-wrap: wrap;
      margin-top: 30px;
    }

    .byoc-filters {
      flex: 1 1 380px;
      min-width: 320px;
    }

    .byoc-mode-toggle {
      margin: 0 0 24px;
    }

    .byoc-freeform {
      display: none;
      margin-bottom: 30px;
    }

    .byoc-freeform.open {
      display: block;
    }

    .freeform-active .byoc-result-col {
      display: none;
    }

    .byoc-freeform-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .byoc-freeform-category {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .byoc-freeform-field {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 92px;
      gap: 8px;
    }

    .byoc-freeform-field--single {
      grid-template-columns: 1fr;
    }

    .byoc-freeform-field--choice {
      grid-template-columns: minmax(0, 1fr) 120px;
    }

    .byoc-freeform-field--second {
      margin-left: 18px;
    }

    .byoc-amount-field {
      display: flex;
      align-items: center;
      gap: 4px;
      min-width: 0;
    }

    .byoc-amount-field input {
      width: 100%;
    }

    .byoc-amount-unit {
      color: var(--muted);
      font: 10px 'IBM Plex Mono', monospace;
    }

    .byoc-freeform-field input,
    .byoc-freeform-field select {
      min-width: 0;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--panel);
      color: var(--cream);
      padding: 9px 10px;
      font: 12px 'IBM Plex Mono', monospace;
      /* Forces native dropdowns (datalist/select popups) to render light bg + dark text consistently across browsers. */
      color-scheme: light;
    }

    .byoc-freeform-result {
      margin-top: 18px;
      border-top: 1px solid var(--border);
      padding-top: 16px;
    }

    .byoc-freeform-result h3 {
      margin: 0 0 8px;
      font: 600 italic 25px 'Cormorant Garamond', serif;
    }

    .byoc-freeform-result p {
      margin: 5px 0;
      font: 11px 'IBM Plex Mono', monospace;
      color: var(--muted);
    }

    .byoc-freeform-meta {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin-top: 12px;
    }

    .byoc-freeform-meta select {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--panel);
      color: var(--cream);
      padding: 9px 10px;
      font: 12px 'IBM Plex Mono', monospace;
      color-scheme: light;
    }

    .byoc-freeform-spec {
      margin-top: 14px;
      color: var(--cream) !important;
      white-space: pre-line;
      line-height: 1.7;
    }

    @media (max-width: 600px) {
      .byoc-freeform-grid { grid-template-columns: 1fr; }
    }

    .byoc-result-col {
      flex: 1 1 300px;
      min-width: 280px;
      position: sticky;
      top: 30px;
    }

    /* ─── Filter Group ─── */
    .byoc-group {
      margin-bottom: 30px;
      margin-top: 0;
    }

    .byoc-filters .byoc-group:first-child {
      margin-top: 0;
    }

    .byoc-label {
      font-size: 15px;
      font-weight: 500;
      position: relative;
      display: inline-block;
      padding-bottom: 2px;
      margin-bottom: 14px;
    }

    .byoc-label::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 1.5px;
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A, #F4C6DD);
      box-shadow: 0 0 3px 0.2px rgba(201, 174, 239, 0.25);
    }

    .byoc-help {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      color: var(--brass);
      margin: 8px 0 0;
      min-height: 14px;
    }

    .byoc-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .byoc-chip {
      font-size: 13px;
      padding: 8px 16px;
      border-radius: 999px;
      cursor: pointer;
      background: var(--panel);
      color: var(--chip-text);
      border: 1px solid var(--border);
      transition: opacity 0.15s;
    }

    .byoc-chip.selected {
      color: #1A1113;
      font-weight: 500;
      border: none;
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A, #F4C6DD);
      background-size: 400% 100%;
      background-position: 20% 50%;
    }

    /* Category-specific selected chip colors */
    #spiritChips .byoc-chip.selected {
      background-position: 0% 50%;
    }

    #citrusChips .byoc-chip.selected {
      background-position: 25% 50%;
    }

    #juiceChips .byoc-chip.selected {
      background-position: 50% 50%;
    }

    /* Syrup chips use category-specific positioning */
    .byoc-category-group:nth-child(1) .byoc-chip.selected {
      background-position: 65% 50%;
    }

    .byoc-category-group:nth-child(2) .byoc-chip.selected {
      background-position: 75% 50%;
    }

    .byoc-category-group:nth-child(3) .byoc-chip.selected {
      background-position: 85% 50%;
    }

    #topChips .byoc-chip.selected {
      background-position: 100% 50%;
    }

    .byoc-chip.disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }

    /* ─── Ring Buttons ─── */
    .byoc-ring {
      display: inline-flex;
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A, #F4C6DD);
      background-size: 300% 100%;
      animation: shimmer 6s linear infinite;
      border-radius: 50%;
      cursor: pointer;
      border: none;
    }

    .byoc-ring-inner {
      background: var(--bg);
      margin: 1px;
      border-radius: 50%;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--cream);
      font-size: 14px;
    }

    /* ─── Slider ─── */
    .byoc-slider-wrap {
      width: 100%;
      max-width: 260px;
    }

    .byoc-slider-track {
      height: 3px;
      border-radius: 2px;
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A);
      position: relative;
      margin: 14px 0;
    }

    .byoc-slider-track .thumb {
      position: absolute;
      top: 50%;
      left: var(--slider-position, 50%);
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--cream);
      transform: translate(-50%, -50%);
      box-shadow: 0 0 0 3px var(--bg);
    }

    .byoc-slider-labels {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      font-family: 'IBM Plex Mono', monospace;
      color: var(--muted);
    }

    .byoc-slider-note {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      color: var(--muted);
      margin-top: 6px;
    }

    .byoc-slider-pending {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9px;
      color: var(--muted);
      margin-top: 8px;
      line-height: 1.5;
    }

    /* ─── Result Card ─── */
    .byoc-card {
      width: 100%;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 26px;
      position: relative;
      overflow: hidden;
    }

    .byoc-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-weight: 600;
      font-size: 26px;
      margin: 0 0 4px;
      position: relative;
      z-index: 3;
    }

    .byoc-card .sub {
      font-size: 11px;
      color: var(--muted);
      font-family: 'IBM Plex Mono', monospace;
      position: relative;
      z-index: 3;
      margin-bottom: 18px;
    }

    .byoc-martini {
      position: absolute;
    }

    .byoc-martini.top-corner {
      top: -12px;
      right: -12px;
      width: 70px;
      height: 70px;
      animation: spin 9s linear infinite;
      opacity: 0.6;
      z-index: 2;
    }

    .byoc-martini.bottom-cut {
      bottom: -40px;
      left: 40%;
      width: 70px;
      height: 70px;
      animation: spin 13s linear infinite;
      opacity: 0.5;
      z-index: 1;
    }

    .byoc-martini.behind-title {
      top: -4px;
      left: 6px;
      width: 80px;
      height: 80px;
      animation: spin 16s linear infinite;
      opacity: 0.5;
      z-index: 1;
    }

    .byoc-spec-list {
      position: relative;
      z-index: 3;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13px;
      line-height: 2;
      margin: 0 0 16px;
    }

    .byoc-spec-list .amt {
      color: var(--brass);
    }

    .byoc-spec-list .swap-note {
      color: var(--muted);
      font-size: 10px;
    }

    .byoc-change-list {
      display: grid;
      gap: 7px;
      margin-top: 12px;
      color: var(--cream);
      font: 12px 'IBM Plex Mono', monospace;
    }

    .byoc-change-list.empty {
      color: var(--muted);
    }

    .byoc-meta-row {
      position: relative;
      z-index: 3;
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--muted);
      font-family: 'IBM Plex Mono', monospace;
      margin-bottom: 18px;
    }

    .byoc-version-toggle {
      position: relative;
      z-index: 3;
      margin-bottom: 16px;
    }

    .byoc-version-help {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      color: var(--brass);
      margin-top: 6px;
    }

    .byoc-garnish-box {
      position: relative;
      z-index: 3;
      border-top: 1px solid var(--border);
      padding-top: 16px;
    }

    .byoc-garnish-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--brass);
      margin-bottom: 8px;
    }

    .byoc-garnish-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .byoc-garnish-text {
      font-size: 13px;
      color: var(--cream);
      flex: 1;
    }

    .byoc-note {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      color: var(--muted);
      margin-top: 16px;
      line-height: 1.6;
    }

    .byoc-outcome-box {
      position: relative;
      z-index: 3;
      border-top: 1px solid var(--border);
      margin-top: 18px;
      padding-top: 16px;
    }

    .byoc-outcome-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--brass);
    }

    .byoc-outcome-read {
      display: grid;
      gap: 7px;
      margin-top: 12px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
    }

    .byoc-outcome-read span {
      color: var(--muted);
    }

    .byoc-outcome-read strong {
      color: var(--cream);
      font-weight: 400;
    }

    .byoc-nudge {
      margin-top: 14px;
      color: var(--cream);
      font-size: 12px;
      line-height: 1.5;
    }

    .byoc-five-options {
      display: none;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 12px;
    }

    .byoc-five-options.open {
      display: flex;
    }

    .byoc-five-options span {
      border: 1px solid var(--border);
      background: var(--panel2);
      color: var(--cream);
      padding: 7px 10px;
      border-radius: 6px;
      font-size: 12px;
    }

    .byoc-ring-button {
      padding: 0;
      background: linear-gradient(90deg, #F4C6DD, #C9AEEF, #9FC6F0, #9CE7EA, #E9C98A, #F4C6DD);
      background-size: 400% 100%;
      background-position: 80% 50%;
      animation: shimmer 6s linear infinite;
      border-radius: 50%;
      cursor: pointer;
      border: none;
    }

    /* ─── Main button (CTA) ─── */
    .byoc-similar-link {
      border: 0;
      border-bottom: 1px dotted var(--brass);
      padding: 0;
      background: transparent;
      color: var(--brass);
      cursor: pointer;
      font: 11px 'IBM Plex Mono', monospace;
      line-height: 1.4;
      white-space: nowrap;
    }

    /* Responsive ─── */
    @media (max-width: 768px) {
      .byoc-grid {
        flex-direction: column;
      }

      .byoc-result-col {
        position: static;
      }

      .byoc-wordmark {
        font-size: 28px;
      }

      .byoc-title {
        font-size: 20px;
        margin: 14px 0 24px;
      }
    }
  </style>

  <div class="byoc-page" id="byocPage">
    <div class="byoc-wrap">
      <svg width="0" height="0" style="position:absolute;">
        <defs>
          <linearGradient id="holo" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#F4C6DD"/>
            <stop offset="20%" stop-color="#C9AEEF"/>
            <stop offset="40%" stop-color="#9FC6F0"/>
            <stop offset="60%" stop-color="#9CE7EA"/>
            <stop offset="80%" stop-color="#E9C98A"/>
            <stop offset="100%" stop-color="#F4C6DD"/>
          </linearGradient>
        </defs>
      </svg>

      <div class="byoc-header">
        <div class="byoc-header-block">
          <h1 class="byoc-wordmark"><span class="elixir">Elixir</span> <span class="maven">Maven</span></h1>
          <p class="byoc-membership">Premium Membership</p>
          <h2 class="byoc-title">Build your own cocktail</h2>
        </div>
        <div class="byoc-toggle" id="unitToggle">
          <div class="active" id="mlBtn"><button>ml</button></div>
          <div id="ozBtn"><button>oz</button></div>
        </div>
      </div>

      <div class="byoc-grid">
        <div class="byoc-filters">
          <div class="byoc-mode-toggle byoc-toggle">
            <div class="active" id="guidedModeBtn"><button type="button">Guided</button></div>
            <div id="freeformModeBtn"><button type="button">Build from scratch</button></div>
          </div>

          <div class="byoc-freeform" id="freeformPanel">
            <div class="byoc-label">Build from scratch</div>
            <div class="byoc-freeform-grid" id="freeformFields"></div>
            <div class="byoc-freeform-meta">
              <select id="freeformGlass" aria-label="Glass"><option>Nick and Nora</option><option>Coupe</option><option>Rocks</option><option>Highball</option><option>Flute</option><option>Tiki</option></select>
              <select id="freeformIce" aria-label="Ice"><option>None</option><option>Cubed</option><option>Large cube</option><option>Crushed</option></select>
              <select id="freeformMethod" aria-label="Method"><option>Shake &amp; Strain</option><option>Shake &amp; Double Strain</option><option>Stir</option><option>Build</option><option>Dry Shake → Shake &amp; Strain</option><option>Dry Shake → Shake &amp; Double Strain</option></select>
            </div>
            <div class="byoc-freeform-result" id="freeformResult"></div>
          </div>

          <div id="guidedPanel">
          <!-- Base spirit -->
          <div class="byoc-group">
            <div class="byoc-label">Base spirit — pick 1, or 2 to split</div>
            <div class="byoc-chips" id="spiritChips"></div>
            <div id="spiritCategories"></div>
            <div class="byoc-help" id="spiritHelp"></div>
          </div>

          <!-- Citrus -->
          <div class="byoc-group">
            <div class="byoc-label">Citrus</div>
            <div class="byoc-chips" id="citrusChips"></div>
            <div class="byoc-help" id="citrusHelp"></div>
          </div>

          <!-- Juice -->
          <div class="byoc-group">
            <div class="byoc-label">Juice</div>
            <div class="byoc-chips" id="juiceChips"></div>
            <div class="byoc-help" id="juiceHelp"></div>
          </div>

          <!-- Syrup -->
          <div class="byoc-group">
            <div class="byoc-label">Syrup</div>
            <div id="syrupCategories"></div>
          </div>

          <!-- Top -->
          <div class="byoc-group">
            <div class="byoc-label">Top</div>
            <div class="byoc-chips" id="topChips"></div>
          </div>

          <!-- Slider -->
          <div class="byoc-group">
            <div class="byoc-label">Sweet — Bitter</div>
            <div class="byoc-slider-wrap">
              <div class="byoc-slider-track" id="flavorSlider"><div class="thumb"></div></div>
                <div class="byoc-slider-labels"><span>Bitter</span><span>Sweet</span></div>
            </div>
              <div class="byoc-slider-pending" id="sliderPending"></div>
          </div>
